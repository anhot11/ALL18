# Nexus18 / All18 Environment Configuration

# Next.js Port & Host
PORT=3000
HOSTNAME=localhost

# Optional: Rotating Proxy Support for Scraping
# HTTP_PROXY=http://user:password@proxy.example.com:8080
# HTTPS_PROXY=http://user:password@proxy.example.com:8080

# Optional: Vercel Deployment Secrets
# VERCEL_TOKEN=
# VERCEL_ORG_ID=
# VERCEL_PROJECT_ID=

# Database Location (Defaults to ./data/nexus18.db)
SQLITE_DB_PATH=./data/nexus18.db

# Electron Configuration
ELECTRON_START_URL=http://localhost:3000
